# Axion Process OS backend configuration
# Copy this file to .env for local development. Never commit real secrets.

HOST=127.0.0.1
PORT=8899
APP_BASE_URL=http://127.0.0.1:8899
PRODUCT_NAME=Axion Process OS
AXION_DATA_DIR=.data

# Local owner/admin access
AXION_ADMIN_USER=owner
AXION_ADMIN_PASSWORD=replace-with-a-private-admin-password
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Internal demo users are seeded by the backend:
# KBrenner / 0105
# MAhmed / 1402

# Paid SaaS checkout
AXION_PRICE_CENTS=240000
AXION_CURRENCY=EUR
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Google Identity Services login
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAINS=

# Production invite email. Resend is supported without extra npm packages.
INVITE_EMAIL_FROM=Axion Process OS <invites@your-domain.com>
RESEND_API_KEY=

# Reserved SMTP settings for later full SMTP transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Python screening model runtime
AXION_PYTHON=python3
AXION_PYTHON_TIMEOUT_MS=15000

# Optional external rigorous CFD worker
CFD_WORKER_URL=
CFD_WORKER_TOKEN=

# Recommended production data layer for the next backend step
# The current prototype stores data in .data/*.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_TABLE=axion_state
SUPABASE_STORAGE_BUCKET=axion-model-data
