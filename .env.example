# Axion Process OS backend configuration
# Copy this file to .env for local development. Never commit real secrets.

HOST=127.0.0.1
PORT=8899
APP_BASE_URL=http://127.0.0.1:8899
PRODUCT_NAME=Axion Process OS
AXION_DATA_DIR=.data
AXION_REQUIRE_PRODUCTION_CONFIG=false

# Optional Next.js backend-for-frontend edge
# API core uses NEXTJS_BFF_URL for readiness/product metadata.
# The Next.js BFF uses AXION_API_BASE_URL to proxy back to this API core.
NEXTJS_BFF_URL=
AXION_API_BASE_URL=http://127.0.0.1:8899

# AI command planner for Cursor-style model edits.
# Store real values in .env.local or backend host secrets, not in Git.
# The key must belong to a project with active billing/quota.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AXION_DISABLE_OPENAI=false

# Local owner/admin access
AXION_ADMIN_USER=owner
AXION_ADMIN_PASSWORD=replace-with-a-private-admin-password
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional seeded workspace users for private deployments.
# Example:
# AXION_SEED_USERS_JSON=[{"username":"process-lead","email":"process-lead@company.com","name":"Process Lead","password":"replace-with-private-password","role":"user","paymentExempt":false}]
AXION_SEED_USERS_JSON=[]

# Paid SaaS checkout
AXION_PRICE_CENTS=240000
AXION_CURRENCY=EUR
AXION_BILLING_MODE=subscription
STRIPE_AUTOMATIC_TAX=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Google Identity Services login
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAINS=

# Production invite email. Use either Resend or SMTP.
INVITE_EMAIL_FROM=Axion Process OS <invites@your-domain.com>
RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Python screening model runtime
AXION_PYTHON=python3
AXION_PYTHON_TIMEOUT_MS=15000

# Optional external rigorous CFD worker
CFD_WORKER_URL=
CFD_WORKER_TOKEN=

# Public backend receives outbound edge status and telemetry. It does not need
# an inbound route to the OT gateway. AUTOMATION_GATEWAY_URL is optional only
# for a privately routed/on-prem backend.
AUTOMATION_GATEWAY_URL=
AUTOMATION_GATEWAY_TOKEN=
AXION_AUTOMATION_WRITES_ENABLED=false
AXION_AUTOMATION_INGEST_TOKEN=
AXION_AUTOMATION_INGEST_OWNER=

# Values used by the separately deployed automation-gateway container.
AUTOMATION_GATEWAY_WRITES_ENABLED=false
AUTOMATION_TAG_MAP=/app/tag-map.json
AUTOMATION_CONNECTION_KIND=simulation
AUTOMATION_CONNECTION_ENDPOINT=axion://verified-simulator
AUTOMATION_PUBLISH_INTERVAL_MS=5000
AXION_BACKEND_URL=
AXION_AUTOMATION_PROJECT_ID=
AXION_AUTOMATION_CONNECTION_ID=
AUTOMATION_SITE_MANIFEST=/run/site-pack/site.json
AUTOMATION_APPROVALS_MANIFEST=/run/site-pack/approvals.json
OPCUA_CERTIFICATE_FILE=/run/secrets/opcua/client-cert.pem
OPCUA_PRIVATE_KEY_FILE=/run/secrets/opcua/client-key.pem
OPCUA_TRUSTED_CERTIFICATES_DIR=/run/secrets/opcua/trusted
AXION_AUTOMATION_CONNECTION_ID=
OPCUA_SECURITY_MODE=SignAndEncrypt
OPCUA_SECURITY_POLICY=Basic256Sha256
OPCUA_CERTIFICATE_FILE=
OPCUA_PRIVATE_KEY_FILE=

# Recommended production data layer. When SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are set, Axion uses Supabase/Postgres instead of
# local .data/*.json for app state and model documents.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_TABLE=axion_state
SUPABASE_DOCUMENTS_TABLE=axion_documents
SUPABASE_STORAGE_BUCKET=axion-model-data
